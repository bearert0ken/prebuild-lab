{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": {
      "label": "PORT-LABEL-TEST \u001b]0;CODESPACES-LABEL-TEST\u0007"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "onCreateCommand": "env | sort > /workspaces/oncreate-env.txt 2>&1 || true",
  "updateContentCommand": "env | sort > /workspaces/updatecontent-env.txt 2>&1 || true",
  "postCreateCommand": "env | sort > /workspaces/postcreate-env.txt 2>&1 || true"
}
